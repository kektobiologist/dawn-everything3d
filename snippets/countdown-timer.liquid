{% comment %}
  Renders the shared countdown-timer script (once per page). Two element
  styles are supported:

  Inline text:
    <span class="countdown-timer" data-countdown-end="2026-08-31T00:00:00+05:30"
          data-countdown-label="Ends in "></span>

  Boxed units (big timer — section provides the markup + styling):
    <div data-countdown-boxes data-countdown-end="...">
      <span data-cd="days">00</span> ... <span data-cd="hours">00</span>
      ... <span data-cd="minutes">00</span> ... <span data-cd="seconds">00</span>
    </div>

  The script updates both every second and hides them once the deadline
  passes (or if the date is invalid).
{% endcomment %}

<style>
  .countdown-timer {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .announcement-bar__message .countdown-timer {
      display: block;
      margin-top: 0.2rem;
    }
  }
</style>

<script>
  (() => {
    if (window.__countdownTimerInit) return;
    window.__countdownTimerInit = true;

    const pad = (n) => String(n).padStart(2, '0');

    const parts = (el) => {
      const end = new Date(el.dataset.countdownEnd).getTime();
      const diff = Math.floor((end - Date.now()) / 1000);
      if (isNaN(end) || diff <= 0) return null;
      return {
        days: Math.floor(diff / 86400),
        hours: Math.floor((diff % 86400) / 3600),
        minutes: Math.floor((diff % 3600) / 60),
        seconds: diff % 60,
      };
    };

    const tick = () => {
      document.querySelectorAll('[data-countdown-boxes]').forEach((el) => {
        const p = parts(el);
        if (!p) {
          el.style.display = 'none';
          return;
        }
        for (const unit of ['days', 'hours', 'minutes', 'seconds']) {
          const span = el.querySelector(`[data-cd="${unit}"]`);
          if (span) span.textContent = pad(p[unit]);
        }
      });

      document
        .querySelectorAll('[data-countdown-end]:not([data-countdown-boxes])')
        .forEach((el) => {
          const p = parts(el);
          if (!p) {
            el.style.display = 'none';
            return;
          }
          const label = el.dataset.countdownLabel || '';
          el.textContent = `${label}${p.days > 0 ? `${p.days}d ` : ''}${pad(p.hours)}h ${pad(p.minutes)}m ${pad(p.seconds)}s`;
        });
    };

    tick();
    setInterval(tick, 1000);
  })();
</script>
