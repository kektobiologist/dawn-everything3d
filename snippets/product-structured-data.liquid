{% comment %}
  Product JSON-LD for agents and rich results.
  Emits a ProductGroup (size/base variants) with brand, SKU, size, INR offers,
  shipping and return details, and AggregateRating from the reviews metafields.

  Usage:
  {% render 'product-structured-data', product: product %}
{% endcomment %}
{%- liquid
  assign size_index = null
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'size'
      assign size_index = forloop.index0
    endif
  endfor

  assign product_url = request.origin | append: product.url
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign description = product.description | strip_html | strip_newlines | replace: '  ', ' ' | strip
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": {% if product.has_only_default_variant %}"Product"{% else %}"ProductGroup"{% endif %},
    "@id": {{ product_url | append: '#product' | json }},
    "name": {{ product.title | json }},
    "url": {{ product_url | json }},
    "description": {{ description | json }},
    "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
    "manufacturer": { "@id": {{ request.origin | append: '/#organization' | json }} },
    "countryOfOrigin": "IN",
    {%- if product.type != blank %}
      "category": {{ product.type | json }},
    {%- endif %}
    {%- if product.metafields.specs.material != blank %}
      "material": {{ product.metafields.specs.material.value | json }},
    {%- endif %}
    {%- if product.featured_image %}
      "image": [
        {%- for image in product.images limit: 5 -%}
          {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
    {%- endif %}
    {%- if rating != blank and rating_count > 0 %}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ rating.rating | json }},
        "bestRating": {{ rating.scale_max | json }},
        "worstRating": {{ rating.scale_min | json }},
        "ratingCount": {{ rating_count | json }}
      },
    {%- endif %}
    {%- if product.has_only_default_variant %}
      {%- assign variant = product.selected_or_first_available_variant %}
      "sku": {{ variant.sku | default: variant.id | json }},
      "offers": {% render 'product-structured-data-offer', variant: variant, product_url: product_url %}
    {%- else %}
      "productGroupID": {{ product.id | json }},
      {%- if size_index != null %}
        "variesBy": ["https://schema.org/size"],
      {%- endif %}
      "hasVariant": [
        {%- for variant in product.variants -%}
          {
            "@type": "Product",
            "@id": {{ product_url | append: '?variant=' | append: variant.id | append: '#variant' | json }},
            "name": {{ product.title | append: ' - ' | append: variant.title | json }},
            "sku": {{ variant.sku | default: variant.id | json }},
            {%- if size_index != null %}
              "size": {{ variant.options[size_index] | json }},
            {%- endif %}
            {%- if product.options.size > 1 or size_index == null %}
              "additionalProperty": [
                {%- for option in product.options -%}
                  {%- unless forloop.index0 == size_index -%}
                    { "@type": "PropertyValue", "name": {{ option | json }}, "value": {{ variant.options[forloop.index0] | json }} }
                    {%- unless forloop.last or forloop.index == size_index %},{% endunless -%}
                  {%- endunless -%}
                {%- endfor -%}
              ],
            {%- endif %}
            {%- assign variant_image = variant.featured_image | default: product.featured_image %}
            {%- if variant_image %}
              "image": {{ variant_image | image_url: width: 1200 | prepend: 'https:' | json }},
            {%- endif %}
            "offers": {% render 'product-structured-data-offer', variant: variant, product_url: product_url %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    {%- endif %}
  }
</script>
