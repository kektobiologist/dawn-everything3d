{{ 'section-studio-spotlight.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="studio-spotlight color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="studio-spotlight__grid{% if section.settings.media_position == 'left' %} studio-spotlight__grid--media-first{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="studio-spotlight__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="studio-spotlight__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="studio-spotlight__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="studio-spotlight__subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="studio-spotlight__features">
            {%- for block in section.blocks -%}
              <li class="studio-spotlight__feature" {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="12" cy="12" r="11" fill="#22c55e" opacity="0.18"/>
                  <path d="m7 12.5 3.2 3.2L17 9" stroke="#16a34a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="studio-spotlight__cta-row">
          {%- if section.settings.button_label != blank -%}
            <a
              href="{{ section.settings.button_link }}"
              class="button button--primary studio-spotlight__button"
            >
              {{ section.settings.button_label | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.note != blank -%}
            <p class="studio-spotlight__note">{{ section.settings.note | escape }}</p>
          {%- endif -%}
        </div>
      </div>

      <div class="studio-spotlight__media">
        {%- assign back_image = section.settings.image_2 -%}
        {%- if back_image != blank or section.settings.asset_image_2 != blank -%}
          <div class="studio-spotlight__phone studio-spotlight__phone--back">
            {%- if back_image != blank -%}
              {{
                back_image
                | image_url: width: 600
                | image_tag:
                  widths: '300, 450, 600',
                  sizes: '(min-width: 990px) 240px, 40vw',
                  loading: 'lazy',
                  alt: section.settings.alt_2
              }}
            {%- else -%}
              <img
                src="{{ section.settings.asset_image_2 | asset_url }}"
                alt="{{ section.settings.alt_2 | escape }}"
                width="710"
                height="1546"
                loading="lazy"
              >
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- assign front_image = section.settings.image_1 -%}
        {%- if front_image != blank or section.settings.asset_image_1 != blank -%}
          <div class="studio-spotlight__phone studio-spotlight__phone--front">
            {%- if front_image != blank -%}
              {{
                front_image
                | image_url: width: 700
                | image_tag:
                  widths: '350, 525, 700',
                  sizes: '(min-width: 990px) 290px, 50vw',
                  loading: 'lazy',
                  alt: section.settings.alt_1
              }}
            {%- else -%}
              <img
                src="{{ section.settings.asset_image_1 | asset_url }}"
                alt="{{ section.settings.alt_1 | escape }}"
                width="710"
                height="1546"
                loading="lazy"
              >
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Studio Spotlight",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Introducing Figurine Studio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design your figurine with AI"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Launch Figurine Studio"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note next to button",
      "default": "Free to try — you only pay when you order"
    },
    {
      "type": "header",
      "content": "Screenshots"
    },
    {
      "type": "select",
      "id": "media_position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right",
      "label": "Screenshot position (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Front screenshot"
    },
    {
      "type": "text",
      "id": "asset_image_1",
      "label": "Front screenshot (theme asset filename)",
      "info": "Optional fallback for developer-managed assets, e.g. studio-step-designs.png"
    },
    {
      "type": "text",
      "id": "alt_1",
      "label": "Front screenshot alt text"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Back screenshot"
    },
    {
      "type": "text",
      "id": "asset_image_2",
      "label": "Back screenshot (theme asset filename)",
      "info": "Optional fallback for developer-managed assets, e.g. studio-step-order.png"
    },
    {
      "type": "text",
      "id": "alt_2",
      "label": "Back screenshot alt text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free AI design previews"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Studio Spotlight",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
